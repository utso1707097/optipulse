# ---- OptiPulse .gitignore ----

# OS / editor
.DS_Store
Thumbs.db
.vs/
.vscode/
.idea/
*.swp

# Secrets / local config (never commit credentials — Constitution Principle VI)
*.env
.env
.env.*
**/appsettings.*.Local.json
**/secrets.json
*.pem
*.key

# Vendored third-party best-practice kits (see README "Note on .kits/")
.kits/

# ---- .NET (backend) ----
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.user
project.lock.json
artifacts/
TestResults/
*.trx
BenchmarkDotNet.Artifacts/

# ---- Node / React (web) ----
node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- Flutter / Dart (mobile) ----
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
**/.pub-cache/
**/.pub/
*.iml
.flutter-plugins-dependencies

# ---- Generated OpenAPI clients (regenerated by contracts-gen) ----
# (kept in source per contract-drift gate; uncomment if you switch to build-time-only)
# web/optipulse_dashboard/src/api/generated/
# mobile/optipulse_app/lib/core/generated/
