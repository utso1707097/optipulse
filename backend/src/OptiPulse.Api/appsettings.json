{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "SchemaStrategy": "Migrate"
  },
  "ConnectionStrings": {
    "Flags": "Data Source=optipulse-flags.db",
    "Audit": "Data Source=optipulse-audit.db",
    "Identity": "Data Source=optipulse-identity.db"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InvalidationChannel": "optipulse:flags:invalidate"
  },
  "Jwt": {
    "Issuer": "optipulse",
    "Audience": "optipulse-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
